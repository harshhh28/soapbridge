package main

import (
{{- if .EnableMCP}}
	"context"
{{- end}}
	"embed"
{{- if .EnableOpenAPI}}
	"encoding/json"
{{- end}}
	"flag"
	"log"
	"net/http"
	"os"

	"github.com/harshhh28/soapbridge/gateway"
{{- if .EnableMCP}}
	"github.com/harshhh28/soapbridge/mcpgen"
{{- end}}
{{- if .EnableOpenAPI}}
	"github.com/harshhh28/soapbridge/openapigen"
{{- end}}
	"github.com/harshhh28/soapbridge/wsdl"
)

//go:embed service.wsdl
var embeddedWSDL embed.FS

func main() {
	addr := flag.String("addr", getenv("ADDR", "{{.Addr}}"), "REST server listen address")
{{- if .EnableMCP}}
	stdio := flag.Bool("stdio", false, "run the MCP server over stdio instead of the REST server")
{{- end}}
	flag.Parse()

	data, err := embeddedWSDL.ReadFile("service.wsdl")
	if err != nil {
		log.Fatalf("reading embedded WSDL: %v", err)
	}
	res, err := wsdl.Parse(data)
	if err != nil {
		log.Fatalf("parsing WSDL: %v", err)
	}
	for _, w := range res.Warnings {
		log.Printf("WARNING: %s", w)
	}
	def := res.Definition

	binding := def.PrimaryBinding()
	if binding == nil {
		log.Fatalf("WSDL %q has no usable SOAP binding", def.Name)
	}
	client := gateway.NewClient(binding.EndpointURL)
	log.Printf("soapbridge gateway for %q: %d operations, upstream SOAP endpoint %s", def.Name, len(def.Operations), binding.EndpointURL)

{{- if .EnableMCP}}
	if *stdio {
		tools := mcpgen.GenerateTools(def)
		srv := mcpgen.NewServer(def.Name, "{{.ServiceVersion}}", tools, client)
		if err := srv.ServeStdio(context.Background(), os.Stdin, os.Stdout); err != nil {
			log.Fatalf("MCP stdio server: %v", err)
		}
		return
	}
{{- end}}

	mux, err := gateway.BuildMux(def)
	if err != nil {
		log.Fatalf("building REST API: %v", err)
	}

{{- if .EnableMCP}}
	mcpTools := mcpgen.GenerateTools(def)
	mcpServer := mcpgen.NewServer(def.Name, "{{.ServiceVersion}}", mcpTools, client)
	mux.HandleFunc("/mcp", mcpServer.HTTPHandler())
{{- end}}

{{- if .EnableOpenAPI}}
	openapiDoc := openapigen.Generate(def, "{{.ServiceName}}", "{{.ServiceVersion}}")
	openapiJSON, err := json.MarshalIndent(openapiDoc, "", "  ")
	if err != nil {
		log.Fatalf("generating OpenAPI document: %v", err)
	}
	mux.HandleFunc("/openapi.json", func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.Write(openapiJSON)
	})
{{- end}}

	mux.HandleFunc("/healthz", func(w http.ResponseWriter, r *http.Request) {
		w.Write([]byte("ok"))
	})

	log.Printf("listening on %s", *addr)
	log.Fatal(http.ListenAndServe(*addr, mux))
}

func getenv(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
