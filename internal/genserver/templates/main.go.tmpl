// newMCPServer builds the MCP tools, applies the annotation overrides and the
// toolSchemas setting from the embedded config.yaml, and returns the server.
// A bad config section is fatal rather than silently ignored.
func newMCPServer(def *model.Definition, client *gateway.Client) *mcpgen.Server {
	tools := mcpgen.GenerateTools(def)
	cfg, err := embeddedFiles.ReadFile("config.yaml")
	if err != nil {
		log.Fatalf("reading embedded config.yaml: %v", err)
	}
	overrides, err := mcpgen.ParseOverrides(cfg)
	if err != nil {
		log.Fatalf("config.yaml: %v", err)
	}
	warnings, err := mcpgen.ApplyOverrides(tools, overrides)
	if err != nil {
		log.Fatalf("config.yaml: %v", err)
	}
	for _, w := range warnings {
		log.Printf("WARNING: %s", w)
	}
	if un := mcpgen.Unannotated(tools); len(un) > 0 {
		log.Printf("note: %d MCP tool(s) have no read-only/destructive annotation (hosts will treat them cautiously): %s", len(un), strings.Join(mcpgen.Abbreviate(un, 10), ", "))
	}

	mode, err := mcpgen.ParseSchemaMode(cfg)
	if err != nil {
		log.Fatalf("config.yaml: %v", err)
	}
	srv := mcpgen.NewServer(def.Name, "{{.ServiceVersion}}", tools, client)
	srv.SchemaMode = mode
	if srv.Compact() {
		log.Printf("MCP: advertising compact tool schemas (the full tools/list would be %.1f MB); full schemas are served by the describe_operation tool. Set toolSchemas: full in config.yaml to disable.", float64(mcpgen.ListSize(tools))/1e6)
	}
	return srv
}
{{- end}}

func getenv(key, fallback string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return fallback
}
