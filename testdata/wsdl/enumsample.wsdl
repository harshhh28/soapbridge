<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written fixture (not a real public service) covering constructs the
  three real-world fixtures don't exercise: an xsd:simpleType enumeration,
  an explicitly nillable element, and a named complexType referenced by a
  request element (rather than only appearing in responses).
-->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                   xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                   xmlns:xs="http://www.w3.org/2001/XMLSchema"
                   xmlns:tns="urn:soapbridge:enumsample"
                   name="EnumSample"
                   targetNamespace="urn:soapbridge:enumsample">
  <wsdl:types>
    <xs:schema elementFormDefault="qualified" targetNamespace="urn:soapbridge:enumsample">
      <xs:simpleType name="Priority">
        <xs:restriction base="xs:string">
          <xs:enumeration value="LOW"/>
          <xs:enumeration value="MEDIUM"/>
          <xs:enumeration value="HIGH"/>
        </xs:restriction>
      </xs:simpleType>
      <xs:complexType name="Ticket">
        <xs:sequence>
          <xs:element name="subject" type="xs:string"/>
          <xs:element name="priority" type="tns:Priority"/>
          <xs:element name="assignee" type="xs:string" minOccurs="0" nillable="true"/>
          <xs:element name="dueAt" type="xs:dateTime" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
      <xs:element name="CreateTicket">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="ticket" type="tns:Ticket"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="CreateTicketResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="id" type="xs:int"/>
            <xs:element name="ticket" type="tns:Ticket"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="CreateTicketSoapIn">
    <wsdl:part name="parameters" element="tns:CreateTicket"/>
  </wsdl:message>
  <wsdl:message name="CreateTicketSoapOut">
    <wsdl:part name="parameters" element="tns:CreateTicketResponse"/>
  </wsdl:message>
  <wsdl:portType name="EnumSamplePortType">
    <wsdl:operation name="CreateTicket">
      <wsdl:documentation>Creates a support ticket.</wsdl:documentation>
      <wsdl:input message="tns:CreateTicketSoapIn"/>
      <wsdl:output message="tns:CreateTicketSoapOut"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="EnumSampleBinding" type="tns:EnumSamplePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="CreateTicket">
      <soap:operation soapAction="urn:soapbridge:enumsample/CreateTicket" style="document"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="EnumSampleService">
    <wsdl:port name="EnumSamplePort" binding="tns:EnumSampleBinding">
      <soap:address location="http://localhost:8199/soap/enumsample"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
